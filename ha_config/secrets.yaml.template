# =============================================================================
# Home Assistant secrets.yaml — AI Hub additions
# =============================================================================
# Copy these entries into your existing /config/secrets.yaml on the HA device.
# NEVER commit the real secrets.yaml to version control.
# This file is a TEMPLATE — replace all placeholder values before deploying.
# =============================================================================

# ── AppDaemon connection ──────────────────────────────────────────────────────
# Generate a Long-Lived Access Token in HA:
#   Profile → Long-Lived Access Tokens → Create Token
appdaemon_token: "YOUR_HA_LONG_LIVED_ACCESS_TOKEN_HERE"

# Password protecting the AppDaemon HTTP API (used by the React frontend).
# Choose any strong random string — this is NOT an HA token.
appdaemon_api_password: "CHOOSE_A_STRONG_RANDOM_PASSWORD_HERE"

# ── LLM provider selection ────────────────────────────────────────────────────
# Set the provider you want to use. Only the matching API key is used at runtime.
# Supported values: openai | gemini | anthropic | openrouter
active_llm_provider: "openai"

# Model slug for the chosen provider. Examples:
#   openai      → gpt-4o | gpt-4.1 | gpt-4o-mini
#   gemini      → gemini-2.5-pro | gemini-2.0-flash
#   anthropic   → claude-sonnet-4-5 | claude-opus-4
#   openrouter  → openai/gpt-4o | anthropic/claude-3.5-sonnet (any openrouter slug)
active_llm_model: "gpt-4o"

# ── LLM API keys ─────────────────────────────────────────────────────────────
# You only need to fill in the key for your active_llm_provider.
# The others can be left as placeholder strings — they are never loaded unless
# active_llm_provider is switched to them.

# OpenAI — https://platform.openai.com/api-keys
openai_api_key: "sk-REPLACE_WITH_YOUR_OPENAI_KEY"

# Google Gemini — https://aistudio.google.com/app/apikey
gemini_api_key: "AIza-REPLACE_WITH_YOUR_GEMINI_KEY"

# Anthropic Claude — https://console.anthropic.com/settings/keys
anthropic_api_key: "sk-ant-REPLACE_WITH_YOUR_ANTHROPIC_KEY"

# OpenRouter — https://openrouter.ai/keys
openrouter_api_key: "sk-or-REPLACE_WITH_YOUR_OPENROUTER_KEY"

# ── GitHub integration ────────────────────────────────────────────────────────
# Personal Access Token with repo scope (read + write contents).
# Generate at: https://github.com/settings/tokens → Fine-grained tokens
# Required scopes: Contents (read & write), Metadata (read)
github_pat: "ghp_REPLACE_WITH_YOUR_GITHUB_PAT"

# The GitHub username or organisation that owns the target repository
github_repo_owner: "your-github-username"

# The repository name (without the owner prefix)
github_repo_name: "your-target-repo-name"
